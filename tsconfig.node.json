{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vite.base.ts", "vite.base.test.ts", "vite.pwa.ts", "vite.pwa.test.ts", "vite.headers.ts", "vite.headers.test.ts", "vite.version.ts", "vite.version.test.ts", "worker/test/harness.ts", "worker/test/*.test.ts", "scripts/release.ts", "scripts/release.test.ts", "scripts/versions.ts", "scripts/versions.test.ts", "scripts/noteOrder.ts", "scripts/noteOrder.test.ts", "scripts/notes-guard.ts", "scripts/notes-guard.test.ts"]
}
