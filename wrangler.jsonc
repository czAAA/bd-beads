// The backend Worker (ticket 71, spec 385): serves the app and the Overview as static assets and the API under /api/*.
// Two environments, each with its own D1 database and R2 bucket. Deploy with `--env dev` or `--env production`.
// Bindings, variables and secrets are NOT inherited between environments, so each one lists its own.
// Variables the maintainer sets in the dashboard (DISABLED_FEATURES above all) must not be declared here: with
// `keep_vars` a deploy leaves them alone, but a value declared here would be put back on every deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bd-beads",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker runs only for /api/*: loading the app never counts as a Worker request and keeps working when
    // /api is over its cap or switched off.
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "dev": {
      "name": "bd-beads-dev",
      "vars": { "WORKER_NAME": "dev" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bd-beads-dev",
          // Filled in by ticket 71 step A2, when the database is created.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "worker/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "bd-beads-dev" }]
    },
    "production": {
      "name": "bd-beads",
      "vars": { "WORKER_NAME": "production" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bd-beads",
          // Filled in by ticket 71 step A2, when the database is created.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "worker/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "bd-beads" }]
    }
  }
}
