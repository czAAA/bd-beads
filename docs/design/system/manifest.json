  "components": [
    {
      "name": "BeadBoard",
      "group": "Canvas",
      "summary": "How a Pattern is drawn: beads on a rounded board, with rulers, the current-row marker, and the technique word and curve behind."
    },
    {
      "name": "Rulers",
      "group": "Canvas",
      "summary": "The row and column numbers along the Pattern: every number shown, every 5th bold, column numbers from 100 turned, and the smallest bead that keeps them readable."
    },
    {
      "name": "BeadCursor",
      "group": "States",
      "summary": "The keyboard cursor on the Pattern: one bead ringed in focus-ring, its row and column marked on the rulers."
    },
    {
      "name": "BeadHover",
      "group": "States",
      "summary": "How the Pattern answers the pointer: outline or colour preview on hover, and the cursors."
    },
    {
      "name": "BeadPill",
      "group": "Header",
      "summary": "A read-only pill naming the open Pattern's Bead, shown in the header after \"currently editing\" and the Pattern summary."
    },
    {
      "name": "BeadsNeeded",
      "group": "Left column",
      "summary": "An expandable panel listing how many beads of each color the Pattern needs, with the total in its title."
    },
    {
      "name": "BottomToolbar",
      "group": "Responsive",
      "summary": "The iPad mini's toolbar: the four tools, the current colour, Undo and Redo, under the thumb so drawing never needs the drawer."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Every clickable action in bd-beads: primary, primary select, secondary, secondary in a box, text, link, icon, round icon and expand variants."
    },
    {
      "name": "CanvasStrip",
      "group": "Canvas",
      "summary": "The 46px header strip at the top of the canvas box: what the Pattern is and how far it is zoomed."
    },
    {
      "name": "ColorPickers",
      "group": "Screens",
      "summary": "The Image colors popover and the Custom colour button."
    },
    {
      "name": "ConfirmDialogs",
      "group": "Screens",
      "summary": "The Delete all? and Replace bead? confirmations."
    },
    {
      "name": "ContextBar",
      "group": "Responsive",
      "summary": "A floating bar above the Progress bar on phone and iPad mini that offers what a Selection can do."
    },
    {
      "name": "ContrastAudit",
      "group": "Accessibility",
      "summary": "Every colour pair the design uses, measured against WCAG 2.2 AA in both themes, before and after the Phase C fixes."
    },
    {
      "name": "ConvertImage",
      "group": "Screens",
      "summary": "The framing step of Convert image, inside the canvas box."
    },
    {
      "name": "DisclosureRow",
      "group": "Toolbox",
      "summary": "A full-width row for a rarely used Tool group (Mirror, Size) that opens its controls in place."
    },
    {
      "name": "Dock",
      "group": "Responsive",
      "summary": "The phone's five buttons, one per kind of tool, each opening its own ToolSheet: the active tool, Colour, Edit, Frame, Pattern."
    },
    {
      "name": "Drawer",
      "group": "Responsive",
      "summary": "The iPad mini's left column, sliding in over the canvas from the left when the header's Tools button is pressed."
    },
    {
      "name": "EmptyCanvas",
      "group": "States",
      "summary": "What the canvas box shows while no Pattern is open."
    },
    {
      "name": "EmptyPanels",
      "group": "States",
      "summary": "Beads needed and Saved Patterns with nothing in them."
    },
    {
      "name": "Glossary",
      "group": "Writing",
      "summary": "The app's nouns in English and Russian, and the names of the 12 Palette colors."
    },
    {
      "name": "Header",
      "group": "Header",
      "summary": "The 64px app header: brand, what is being edited, Replace bead, imports, New Pattern, language, theme and shortcuts."
    },
    {
      "name": "HeaderMenu",
      "group": "Header",
      "summary": "The menu button next to the logo at every screen size and the menu it opens, built on the Menu card; it replaces the More menu (OverflowMenu, archived in v15)."
    },
    {
      "name": "HighContrastTheme",
      "group": "Accessibility",
      "summary": "The added third theme, contrast: 7:1 text, 2px borders at 3:1, no shadows, a 3px black focus ring."
    },
    {
      "name": "ImportResult",
      "group": "Screens",
      "summary": "The one-line result or error beside Import a file and Import QR code."
    },
    {
      "name": "InteractionStates",
      "group": "States",
      "summary": "Every interactive component at rest, hovered, pressed, focused, disabled and selected; the samples are live."
    },
    {
      "name": "KeyboardFocus",
      "group": "Accessibility",
      "summary": "The Tab order across the desktop layout and the keyboard rules: one stop per group, arrows inside, Escape closes the top-most layer."
    },
    {
      "name": "Loading",
      "group": "States",
      "summary": "The waiting indicators: three beads, or a progress line when the share done is known."
    },
    {
      "name": "LongerText",
      "group": "Writing",
      "summary": "How controls make room for longer strings (Russian runs about a quarter longer): drop to icons by priority, wrap, or cut only user text."
    },
    {
      "name": "Menu",
      "group": "Overlays",
      "summary": "A popup list anchored under its button (Export ▾), and the Tooltip."
    },
    {
      "name": "Message",
      "group": "Feedback",
      "summary": "A notice or toast: \"couldn't save\", import results and errors, confirmations of an action."
    },
    {
      "name": "MirrorSizeControls",
      "group": "Screens",
      "summary": "The Mirror and Size disclosure rows opened in place, and the Estimated size warning."
    },
    {
      "name": "Modal",
      "group": "Overlays",
      "summary": "A centered dialog for confirmations (Delete all?, Replace bead?), the QR export panel and the keyboard shortcuts."
    },
    {
      "name": "Motion",
      "group": "States",
      "summary": "How things move: four durations, three easings, and the rules that keep motion off the Pattern; the buttons in the preview play each motion."
    },
    {
      "name": "NameOnExports",
      "group": "Screens",
      "summary": "Where the maker's name for the PDF and PNG exports is set: the last row of the Export ▾ menu, and More on the phone."
    },
    {
      "name": "NewPatternForm",
      "group": "Screens",
      "summary": "The form that makes a new Pattern, in the left column while no Pattern is open."
    },
    {
      "name": "NumberField",
      "group": "Forms",
      "summary": "A number input with its unit inside, and the Select that shares its look."
    },
    {
      "name": "NumbersAndUnits",
      "group": "Writing",
      "summary": "How counts, sizes, weights, units, percentages, ranges and dates are written in English and Russian."
    },
    {
      "name": "OverflowMenu",
      "group": "Responsive",
      "summary": "Replaced in v15 by HeaderMenu and archived under archived/components/OverflowMenu; do not use."
    },
    {
      "name": "Overview",
      "group": "Onboarding",
      "summary": "The one page outside the editor, at /overview: the front door for a new visitor (empty Pattern library), reachable from the header menu, drawn lighter and more…"
    },
    {
      "name": "PaletteSwatches",
      "group": "Toolbox",
      "summary": "The Colors group: the Pattern's Palette as an 8-column grid of square swatches, then Custom and Image colors."
    },
    {
      "name": "PhoneForms",
      "group": "Screens",
      "summary": "New Pattern and Convert image framing on a phone."
    },
    {
      "name": "PngExport",
      "group": "Print",
      "summary": "The PNG export: the whole Pattern on its board, with a narrow story column beside it."
    },
    {
      "name": "PrintChartPage",
      "group": "Print",
      "summary": "A chart page of the PDF: one part of the Pattern, filling the sheet, to work from at the craft table."
    },
    {
      "name": "PrintPage1",
      "group": "Print",
      "summary": "The first page of the PDF: the whole Pattern large on its board, with Beads needed in beads and grams and the facts beside it."
    },
    {
      "name": "PrintStrips",
      "group": "Print",
      "summary": "Long thin Patterns (bracelets) stack several parts on one sheet; the PNG of a wide Pattern puts its story under the chart."
    },
    {
      "name": "PrintWide",
      "group": "Print",
      "summary": "A Pattern wider than tall prints on landscape A4 with the same layout: the canvas and the Beads needed column on page 1, one part per chart page."
    },
    {
      "name": "ProgressBar",
      "group": "Canvas",
      "summary": "The 56px bar along the canvas box's bottom edge holding every Row progress control."
    },
    {
      "name": "QrExport",
      "group": "Screens",
      "summary": "The modal that shows a Pattern as a QR code, and its too-large state."
    },
    {
      "name": "SaveBox",
      "group": "Left column",
      "summary": "The second box of the left column: the library's save state, Save Pattern and the Export menu."
    },
    {
      "name": "SaveStates",
      "group": "States",
      "summary": "Save failed, not saved and Saved."
    },
    {
      "name": "SavedPatterns",
      "group": "Left column",
      "summary": "The fourth box of the left column: the five most recently saved Patterns as round thumbnails, expandable to all."
    },
    {
      "name": "SavedPatternsExpanded",
      "group": "Screens",
      "summary": "Saved Patterns expanded to every Pattern, with its export footer."
    },
    {
      "name": "ScreenReaders",
      "group": "Accessibility",
      "summary": "Landmarks, the accessible name of the Pattern, a name for every icon-only button, and what gets announced."
    },
    {
      "name": "ScreenSizes",
      "group": "Responsive",
      "summary": "The five screen tiers side by side: Phone, iPad mini, iPad 13″, MacBook Air and 24″ and larger (the MacBook Air layout, wider)."
    },
    {
      "name": "SegmentedControl",
      "group": "Forms",
      "summary": "Two or three always-visible choices: Technique, Unit, Change from."
    },
    {
      "name": "ShortcutsHelp",
      "group": "Screens",
      "summary": "The Keyboard shortcuts modal: every shortcut, grouped as in the Toolbox."
    },
    {
      "name": "StackingOrder",
      "group": "Accessibility",
      "summary": "Which layer sits above which: the twelve zIndex tokens, from the canvas overlays up to tooltips."
    },
    {
      "name": "Stepper",
      "group": "Forms",
      "summary": "The − value + control for every counted setting on desktop: Mirror axes, Size, Colors at most."
    },
    {
      "name": "SwitchAndFileButton",
      "group": "Forms",
      "summary": "The labelled on/off Switch, and the FileButton that opens the file picker with its limits written under it."
    },
    {
      "name": "TextField",
      "group": "Forms",
      "summary": "A single-line text input with its label, hint and error."
    },
    {
      "name": "ThemeToggle",
      "group": "Header",
      "summary": "The four-way theme control in the header (Match device, Light, Dark, High contrast); the EN / RU language button sits beside it."
    },
    {
      "name": "ToolSheet",
      "group": "Responsive",
      "summary": "The bottom sheet a Dock button opens on the phone, holding every option of that kind."
    },
    {
      "name": "ToolTabs",
      "group": "Toolbox",
      "summary": "The Tools group: four equal tabs (Paint, Fill, Select, Eraser) over a 1px line-strong rule, with Remove line and Delete all underneath."
    },
    {
      "name": "Toolbox",
      "group": "Toolbox",
      "summary": "The first box of the left column: Tool groups Tools, Colors and Edit, then the Mirror and Size disclosure rows."
    },
    {
      "name": "TourPattern",
      "group": "Onboarding",
      "summary": "The finished Pattern every Tour builds: 10 columns × 75 rows, loom, the default Bead, Palette Yellow #f2c94c and Black #1a1a1a only; five gold rhombuses with a…"
    },
    {
      "name": "TourStep",
      "group": "Onboarding",
      "summary": "The Tour: eleven steps inside the real editor; each step card names the tool it teaches, points at one control with a grey dotted line, lights that control in…"
    },
    {
      "name": "WritingPatterns",
      "group": "Writing",
      "summary": "How the app talks: the voice, and one sentence pattern for each kind of message, in English and Russian."
    },
    {
      "name": "ZoomPill",
      "group": "Responsive",
      "summary": "The phone's zoom control: zoom out, the zoom level, zoom in and fit, floating in the bottom-right corner of the Pattern."
    }
  ],
