{
  "name": "openbeads",
  "short_name": "openbeads",
  "description": "A free bead pattern editor that works in three techniques. Loom, peyote, and brick stitch. Turn a photo into a bead pattern, count every color and mark rows done as you weave. Everything here is free: no account, no trial, and your work stays in this browser.",
  "categories": ["design", "lifestyle", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "id": "./",
  "start_url": "app/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fafafa",
  "theme_color": "#fafafa",
  "icons": [
    { "src": "icons/bd-beads-app-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/bd-beads-app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/bd-beads-app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/bd-beads-app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ],
  "screenshots": [
    { "src": "screenshots/editor-wide.png", "sizes": "1366x768", "type": "image/png", "form_factor": "wide", "label": "The editor with a peyote band in Diamonds open" },
    { "src": "screenshots/editor-tall.png", "sizes": "820x1180", "type": "image/png", "form_factor": "narrow", "label": "The editor with a brick stitch V fringe earring open" }
  ]
