// knip (ticket 311): unused files, exports and dependencies. `npm run knip` runs two runs, in CI's "Typecheck and lint"
// job and in `npm run check`:
// 1. `knip`: the whole repo, tests included, so a test that reads an export counts as a use.
// 2. `knip --production` (ticket 0609): the app alone, from the entries and project files marked `!`, with tests and
//    their helpers left out. It fails on a file or export only tests reach: delete it, or move a fixture builder into
//    the test helpers. An export the app keeps and tests also name on purpose (a limit a test counts with, a step a
//    test drives on its own) is tagged `@internal` in its doc comment, with the reason; this run leaves those out.
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // The Vite config's three pages (the editor, the Homepage, ADR 0040, and the not-found page) are the app's entries; Vitest and Playwright
  // entries come from their plugins. These are the helpers those find no importer for, and the
  // test-only Worker its harness bundles (knip finds the Worker itself through wrangler.jsonc). browserSetup.ts is the
  // browser project's setup file, which a machine without Chromium (CI's check job) leaves out of the Vitest config.
  // Until ticket 0323 the Worker's size cap, storage limit, body reader and blob stores have no caller but the fixture
  // Worker (docs/testing/worker.md), so the production run takes those and the fixture Worker as entries of their own.
  // Sign-in (ticket 0078) calls only the `turnstile` and `rateLimit` guards, and the Settings kept in step (1086) the
  // size cap and the JSON body, as feedback does; View links (0323) give the rest their caller, and that ticket
  // removes the `!` from the fixture Worker and the three entries after it.
  // The production run does not follow wrangler.jsonc's Worker past its entry, so the feedback route, the one route the
  // domain/ builder it shares with the app is read by, is an entry of its own (ticket 0699). The UX audit's walk config
  // (ticket 0815) is run by hand through scripts/ux-walk.sh, and the store images' config (ticket 1057) through
  // `npm run store:images`, so no plugin finds them. The Homepage's copy for crawlers (ticket 1055) is run by the
  // build through Vite by its path (vite.crawler.ts), which no import shows.
  "entry": [
    "playwright.ux-audit.config.ts",
    "playwright.store.config.ts",
    "index.html!",
    "app/index.html!",
    "404.html!",
    "src/browserSetup.ts",
    "src/testUtils/*.{ts,vue}",
    "e2e/support/*.ts",
    "worker/src/feedback.ts!",
    "worker/test/fixtureWorker.ts!",
    "worker/src/guards.ts!",
    "worker/src/body.ts!",
    "worker/src/blobs.ts!",
    "src/homepage/pageCopy.ts!"
  ],
  // `src/testSetup.ts` and `src/unitSetup.ts` are the tests' setup files, which the production run does not know as one.
  "project": ["src/**/*.{ts,vue}!", "!src/testSetup.ts!", "!src/unitSetup.ts!", "e2e/**/*.ts", "worker/src/**/*.ts!", "worker/**/*.ts", "*.ts"],
  "rules": {
    // Deliberate aliases: the three per-Technique slow-framing thresholds (imageFraming.ts), DEFAULT_THEME (beadLook.ts).
    "duplicates": "off"
  }
  // Unused exported types are reported on purpose: a type nothing imports is a public name nothing needs, and the
  // fix is one word (drop `export`).
}
